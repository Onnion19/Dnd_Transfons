/** End of HAL code */

:: StoryStylesheet [stylesheet]
/* =========================
CALA SORDA QUIZ STYLE
Twine / Harlowe
Text esquerra / imatge dreta
========================= */

.cover-page { min-height: 90vh; padding: 4rem; border-radius: 18px; background-image: linear-gradient( rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35) ), url("images/cala-sorda.png"); background-size: cover; background-position: center; color: white; }

/* Base de la història */
tw-story {
background: #0f1715;
color: #f3ead8;
font-family: Georgia, "Times New Roman", serif;
font-size: 30}

/* Treu marges grans de Twine */
tw-passage {
max-width: none;
margin: 0;
padding: 0;
}

/* Amaga la barra lateral de Harlowe */
tw-sidebar {
display: none;
}

/* =========================
ESCENA PRINCIPAL
========================= */

.scene {
min-height: 100vh;
position: relative;
overflow: hidden;
box-sizing: border-box;

display: flex;
align-items: center;
justify-content: flex-start;

padding: 5vh 5vw;

background:
linear-gradient(
90deg,
#101915 0%,
#14211c 44%,
#0f1715 44%,
#0f1715 100%
);
}

/* Imatge a la dreta */
.scene::after {
content: "";
position: absolute;
top: 0;
right: 0;
bottom: 0;

width: 58%;

background-image:
linear-gradient(
90deg,
rgba(16, 25, 21, 0.96) 0%,
rgba(16, 25, 21, 0.68) 14%,
rgba(16, 25, 21, 0.22) 38%,
rgba(16, 25, 21, 0.08) 100%
),
var(--bg);

background-size: cover;
background-position: center;
background-repeat: no-repeat;

z-index: 0;
}

/* Permet que aquestes classes existeixin sense canviar el layout */
.scene.left,
.scene.right,
.scene.question-scene {
justify-content: flex-start;
align-items: center;
}

/* =========================
TARGETA DE TEXT
========================= */

.card {
position: relative;
z-index: 1;

width: min(560px, 38vw);
max-height: 88vh;
overflow-y: auto;

padding: 2rem 2.2rem;
border-radius: 24px;

background:
linear-gradient(
rgba(34, 43, 35, 0.84),
rgba(15, 24, 21, 0.92)
);

border: 1px solid rgba(226, 211, 170, 0.28);
box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);

backdrop-filter: blur(6px);
}

/* Targetes de pregunta i resultat */
.card.question,
.card.result {
width: min(540px, 38vw);
max-width: 540px;
}

/* Scroll discret dins la targeta */
.card::-webkit-scrollbar {
width: 8px;
}

.card::-webkit-scrollbar-track {
background: rgba(255, 255, 255, 0.04);
border-radius: 999px;
}

.card::-webkit-scrollbar-thumb {
background: rgba(246, 230, 189, 0.28);
border-radius: 999px;
}

/* =========================
TIPOGRAFIA
========================= */

.card h1,
.card h2 {
margin-top: 0;
margin-bottom: 1rem;
line-height: 1.08;
color: #f6e6bd;
font-weight: 600;
letter-spacing: 0.02em;
}

.card h1 {
font-size: clamp(2.1rem, 4vw, 4rem);
}

.card h2 {
font-size: clamp(1.55rem, 2.4vw, 2.7rem);
}

.card p {
font-size: clamp(1.4rem, 1.1vw, 1.58rem);
line-height: 1.58;
color: #efe6d4;
}

.small {
font-size: 0.95rem;
opacity: 0.82;
}

/* Etiqueta petita sobre el títol */
.kicker {
margin-bottom: 0.75rem;
color: #b9d7ca;
font-size: 0.78rem;
letter-spacing: 0.16em;
text-transform: uppercase;
}

/* Separador subtil */
.divider {
height: 1px;
margin: 1.4rem 0;
background: linear-gradient(
to right,
transparent,
rgba(246, 230, 189, 0.45),
transparent
);
}

/* =========================
LINKS DE TWINE COM A BOTONS
========================= */

tw-link {
display: block;
margin-top: 0.75rem;
padding: 0.8rem 1rem;

border-radius: 16px;
border: 1px solid rgba(229, 213, 172, 0.35);

background: rgba(37, 78, 72, 0.64);
color: #fff1c9;

font-family: Georgia, "Times New Roman", serif;
font-size: 0.95rem;
line-height: 1.35;
text-decoration: none;

transition:
transform 0.15s ease,
background 0.15s ease,
border-color 0.15s ease;
}

tw-link:hover {
background: rgba(60, 105, 91, 0.82);
border-color: rgba(246, 230, 189, 0.7);
transform: translateY(-1px);
}

tw-link:visited {
color: #fff1c9;
}

/* =========================
IMATGES DE FONS
Canvia els noms si els teus arxius tenen altres noms
========================= */

.scene-cover {
--bg: url("images/cala-sorda.png");
}

.scene-port {
--bg: url("images/cala-sorda-port.png");
}

.scene-visitants {
--bg: url("images/cala-sorda-visitants.png");
}

.scene-tranquilitat {
--bg: url("images/cala-sorda-tranquilitat.png");
}

.scene-rutina {
--bg: url("images/cala-sorda-rutina.png");
}

.scene-resultat-tranquil {
--bg: url("images/cala-sorda-llar.png");
}

.scene-resultat-inquiet {
--bg: url("images/cala-sorda-far-boira.png");
}

.scene-resultat-aventurer {
--bg: url("images/cala-sorda-horitzo.png");
}

.scene-pregunta-aventurer {
  --bg: url("images/cala-sorda-aventurer-pregunta.png");
}

.scene-pregunta-inquiet {
  --bg: url("images/pregunta-inquiet.png");
}

.scene-pregunta-tranquil-1 {
--bg: url("images/pregunta-tranquil-1.png");
}

.scene-pregunta-tranquil-gent {
--bg: url("images/pregunta-tranquil-gent.png");
}

.scene-pregunta-tranquil-mans {
--bg: url("images/pregunta-tranquil-mans.png");
}

.scene-tots-transfons {
--bg: url("images/cala-sorda.png");
}


/* =========================
TRANSFONS
========================= */
.scene-transfons-buscador-aventures {
  --bg: url("images/transfons-buscador-aventures.png");
}

.scene-transfons-somiador-horitzons {
  --bg: url("images/transfons-somiador-horitzons.png");
}

.scene-transfons-escola-capella {
  --bg: url("images/transfons-escola-capella.png");
}

.scene-transfons-comerciant-local {
--bg: url("images/transfons-comerciant-local.png");
}

.scene-transfons-cartograf {
--bg: url("images/transfons-cartograf.png");
}

.scene-transfons-artesa {
--bg: url("images/transfons-artesa.png");
}

.scene-transfons-herborista {
--bg: url("images/transfons-herborista.png");
}

.scene-transfons-tocat-trama {
--bg: url("images/transfons-tocat-trama.png");
}

.scene-tots-transfons {
  --bg: url("images/tots-els-transfons.png");
}

/* =========================
MÒBIL / PANTALLES PETITES
========================= */

@media (max-width: 900px) {
.scene {
justify-content: center;
padding: 3vh 4vw;
background: #0f1715;
}

.scene::after {
width: 100%;


background-image:
  linear-gradient(
    rgba(8, 18, 18, 0.56),
    rgba(8, 18, 18, 0.82)
  ),
  var(--bg);


}

.card,
.card.question,
.card.result {
width: min(92vw, 620px);
max-width: 620px;
max-height: 90vh;
}

.card {
padding: 1.6rem 1.6rem;
}

.card h1 {
font-size: clamp(2rem, 9vw, 3.2rem);
}

.card h2 {
font-size: clamp(1.45rem, 7vw, 2.3rem);
}
}

